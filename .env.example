# Copy to .env, then add each secret encrypted — never as plaintext:
#
#   cp .env.example .env
#   npx @dotenvx/dotenvx set OPENROUTER_API_KEY    # prompts for the value
#
# The first `set` makes the keypair and asks where to keep the private key;
# the OS keychain keeps it off disk. Back that key up: without it, nothing in
# .env can be decrypted. .env and .env.keys are both gitignored.

# --- Phase 0: corpus pipeline ---
# HuggingFace token, needed by pyannote for diarization.
# Get one at https://huggingface.co/settings/tokens (read access is enough),
# then accept the gated model terms — see SETUP.md step 3.
HF_TOKEN=

# --- Phase 1: the brain ---
# https://openrouter.ai/keys — pay-as-you-go, no subscription credit involved.
OPENROUTER_API_KEY=

# Which model the agent runs on, via OpenRouter. Flip this to A/B the register.
OPENROUTER_MODEL=z-ai/glm-5.3-flash

# --- Phase 2: speech-to-text ---
# https://console.deepgram.com — not needed until the voice loop.
DEEPGRAM_API_KEY=

# --- Phase 4: Google Calendar ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID >
# Desktop app. Open the downloaded JSON and `set` these two fields from it — no
# client-secrets file is ever read from disk, only these two values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Written for you, encrypted, by: python -m brain.authorize_google. Don't paste by hand.
GOOGLE_TOKEN_JSON=

# --- Spotify playback (optional) ---
# developer.spotify.com/dashboard > Create app > tick "Web API", and add the
# redirect URI http://127.0.0.1:8888/callback exactly. `set` the app's Client
# ID and Client Secret. Playback control needs Spotify Premium.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Written for you, encrypted, by: python -m brain.authorize_spotify. Don't paste by hand.
SPOTIFY_TOKEN_JSON=

# Optional, and ignored once the bot's own player is set up (SETUP.md step 14.3).
# Without that player, the bot uses whatever device has Spotify open; set this
# (part of the device's name, e.g. Web Player) to choose between several.
SPOTIFY_DEVICE_NAME=
